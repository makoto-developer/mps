# Docker Compose Configuration

# PostgreSQL
POSTGRES_USER=drawingapp
POSTGRES_PASSWORD=drawingapp_password
POSTGRES_DB=drawingapp
POSTGRES_PORT=5433

# Database URL (for Prisma)
DATABASE_URL="postgresql://drawingapp:drawingapp_password@localhost:22302/drawingapp"

# Application
NODE_ENV=development

# JWT Configuration
# CRITICAL: Generate a secure random secret for production
# Use: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_256_BIT_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=24h

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# PGAdmin (optional, port 22305)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=22305

# Phoenix Signaling Server (port 22303)
PHX_HOST=localhost
PHX_PORT=22303
# Generate with: mix phx.gen.secret
PHX_SECRET_KEY_BASE=dev_secret_key_base_min_64_bytes_long_for_development_purposes_only_change_in_prod

# TURN Server Configuration (port 22304)
TURN_EXTERNAL_IP=your.public.ip
TURN_SECRET=your_turn_secret

# Frontend WebRTC Configuration
NEXT_PUBLIC_PHOENIX_URL=ws://localhost:22303
NEXT_PUBLIC_TURN_URL=turn:localhost:22304
NEXT_PUBLIC_TURN_USERNAME=drawingapp
NEXT_PUBLIC_TURN_CREDENTIAL=drawing_turn_secret_2024
