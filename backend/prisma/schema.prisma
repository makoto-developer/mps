// Generated by Drawing App DSL
// Do not edit manually

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  email String @unique
  nickname String
  role String @default("USER")
  isBlocked Boolean @default(false)
  rooms Room[] @relation("RoomcreatedBy")
  messages Message[] @relation("UserMessages")
  strokes DrawingStroke[] @relation("UserStrokes")
}

model Room {
  id String @id @default(uuid())
  title String
  theme String
  createdBy User @relation("RoomcreatedBy", fields: [createdById], references: [id])
  createdById String
  messages Message[] @relation("RoomMessages")
  strokes DrawingStroke[] @relation("RoomStrokes")
}

model Message {
  id String @id @default(uuid())
  content String
  createdAt DateTime @default(now())
  room Room @relation("RoomMessages", fields: [roomId], references: [id])
  roomId String
  user User @relation("UserMessages", fields: [userId], references: [id])
  userId String
}

model DrawingStroke {
  id String @id @default(uuid())
  tool String
  color String
  width Int
  points String
  createdAt DateTime @default(now())
  room Room @relation("RoomStrokes", fields: [roomId], references: [id])
  roomId String
  user User @relation("UserStrokes", fields: [userId], references: [id])
  userId String
}
